repository-code: https://github.com/BanroxArt/bridge-conformance
license: MIT
version: 0.1.0
date-released: 2026-11-16
keywords:
  - webhooks
  - payments
  - idempotency
  - fault-injection
  - property-based-testing
  - stablecoin
  - ach
  - fednow
